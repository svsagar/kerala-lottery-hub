# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/kerala_lottery

# API Configuration
API_PORT=3001
API_HOST=localhost
NODE_ENV=development

# Frontend Configuration
VITE_API_URL=http://localhost:3001/api/v1

# Kerala Lotteries Official Source
KERALA_LOTTERY_SOURCE_URL=https://result.keralalotteries.com/

# Data Ingestion
INGESTION_TIMEOUT_MS=30000
INGESTION_RETRY_ATTEMPTS=3
INGESTION_RETRY_BACKOFF_MS=1000

# Statistical Analysis
BACKTESTING_MIN_SAMPLE_SIZE=50
BACKTESTING_MONTE_CARLO_ITERATIONS=10000
BACKTESTING_ALPHA=0.05

# Optional: AI Provider Integration (not required for core functionality)
OPENAI_API_KEY=

# Logging
LOG_LEVEL=debug
