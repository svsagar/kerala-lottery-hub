{
  "name": "@kerala-lottery/api",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "node --loader tsx/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node --loader tsx/esm prisma/seed.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "@prisma/client": "^5.8.0",
    "zod": "^3.22.4",
    "axios": "^1.6.5",
    "jsdom": "^23.0.1",
    "dotenv": "^16.3.1",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "uuid": "^9.0.1",
    "@kerala-lottery/shared": "*",
    "@kerala-lottery/statistics": "*",
    "@kerala-lottery/data-ingestion": "*"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "@types/compression": "^1.7.5",
    "typescript": "^5.4.5",
    "tsx": "^4.7.0",
    "vitest": "^1.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
